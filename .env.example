# ─── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.prestige-conciergerie.com
# Numéro WhatsApp au format international, chiffres uniquement (ex : 32470000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=32470000000
NEXT_PUBLIC_CONTACT_EMAIL=contact@prestige-conciergerie.com
NEXT_PUBLIC_CONTACT_PHONE=+32 470 00 00 00

# ─── Google Calendar (compte dédié PRESTIGE CONCIERGERIE) ──
# OAuth2 : identifiants d'une application "Web" dans Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token obtenu une fois via le consentement OAuth du compte dédié
GOOGLE_REFRESH_TOKEN=
# Calendrier par défaut (ex : primary ou xxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary
# Optionnel : un calendrier par véhicule, JSON {"porsche-taycan":"xxx@group.calendar.google.com"}
# Les véhicules absents de cette table utilisent GOOGLE_CALENDAR_ID + tag "vehicle" (extendedProperties).
GOOGLE_CALENDAR_MAP=
# Jeton secret partagé avec Google lors de l'enregistrement du webhook (events.watch)
GOOGLE_WEBHOOK_TOKEN=
# Secret pour protéger /api/calendar-watch (enregistrement du canal push)
ADMIN_SECRET=
